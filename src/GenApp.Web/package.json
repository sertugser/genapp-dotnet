{
  "name": "genapp-web",
  "private": true,
  "version": "0.1.0",
  "description": "GenApp web arayüzü (React). Derlenmiş dosyalar src/GenApp.Api/wwwroot/assets altına yazılır ve API tarafından sunulur.",
  "scripts": {
    "build": "esbuild src/main.jsx --bundle --minify --target=es2020 --jsx=automatic --outfile=../GenApp.Api/wwwroot/assets/app.js",
    "watch": "esbuild src/main.jsx --bundle --sourcemap --target=es2020 --jsx=automatic --outfile=../GenApp.Api/wwwroot/assets/app.js --watch"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-icons": "5.6.0"
  },
  "devDependencies": {
    "esbuild": "0.27.7"
  }
}
